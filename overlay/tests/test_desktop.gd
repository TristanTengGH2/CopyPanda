extends SceneTree
const Platform = preload("res://desktop_platform.gd")
const Bridge = preload("res://session_bridge.gd")

func _initialize() -> void:
	call_deferred("_check")

func _check() -> void:
	assert(Platform.helper_path("macOS","/Applications/CopyPanda.app/Contents/MacOS/CopyPanda")=="/Applications/CopyPanda.app/Contents/Helpers/CopyPanda.SessionEvents")
	assert(Platform.helper_path("Windows","C:/CopyPanda/CopyPanda.exe")=="C:/CopyPanda/CopyPanda.SessionEvents.exe")
	assert(Platform.helper_path("Linux","/app/copypanda").is_empty())
	assert(Platform.recovery_hint("macOS",true).contains("menu-bar"))
	assert(Platform.recovery_hint("macOS",false).contains("Dock"))
	assert(not Platform.recovery_hint("macOS",true).contains("Windows"))
	assert(Platform.data_directory("macOS",false,true)=="user://qa/","Signed app QA must not modify the bundle")
	assert(Platform.data_directory("macOS",true,true)=="res://qa-data/")
	assert(Platform.data_directory("macOS",false,false)=="user://")
	var bridge = Bridge.new()
	assert(bridge.consume({"kind":"ready","serial":"a"})=="ready" and bridge.ready)
	assert(bridge.consume({"kind":"suspend","serial":"a"})=="","Repeated event is ignored")
	assert(bridge.consume({"kind":"suspend","serial":"638999999999999991"})=="suspend")
	assert(bridge.consume({"kind":"resume","serial":"638999999999999992"})=="resume","Large event IDs must not lose precision")
	assert(bridge.consume({"kind":"resume"})=="")
	assert(bridge.consume({"kind":"unknown","serial":"d"})=="")
	var app = load("res://main.tscn").instantiate()
	root.add_child(app)
	await process_frame
	app.model.new_session("focus")
	app.model.elapsed_ms = 61000
	app.model.start(Time.get_ticks_msec())
	app._handle_session_event("focus_lost")
	assert(app.model.running,"Working in another app must keep the timer running")
	app._handle_session_event("suspend")
	assert(not app.model.running and app.model.elapsed_ms==61000,"Sleep pauses without inventing time")
	app._handle_session_event("resume")
	assert(not app.model.running,"Wake never automatically restarts study")
	app.model.start(Time.get_ticks_msec())
	app._handle_session_event("session_inactive")
	assert(not app.model.running,"User-session switch pauses study")
	app.model.start(Time.get_ticks_msec())
	app._handle_session_event("display_sleep")
	assert(not app.model.running,"Display sleep pauses study")
	print("CopyPanda desktop platform checks passed: 20")
	quit(0)
