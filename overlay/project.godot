config_version=5

[application]
config/name="CopyPanda"
config/version="1.1.0-preview.1"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="CopyPanda"
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=33333
run/max_fps=30

[display]
window/size/viewport_width=360
window/size/viewport_height=320
window/size/window_width_override=360
window/size/window_height_override=320
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true
window/handheld/orientation=1
window/dpi/allow_hidpi=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
driver/enable_input=false
